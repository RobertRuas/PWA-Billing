\fs30 \cf2 O Nginx serve os ficheiros est\'e1ticos e faz proxy transparente para o PocketBase. Apps dentro de 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 /app/
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0  recebem SPA fallback autom\'e1tico \'97 qualquer rota que n\'e3o corresponda a um ficheiro devolve 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 /app/index.html
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 .\
\pard\pardeftab720\sa320\partightenfactor0

\f2\b\fs40 \AppleTypeServices\AppleTypeServicesF65539 \cf2 Criar uma app\
\pard\pardeftab720\partightenfactor0

\f0\fs24 \AppleTypeServices \cf6 \cb7 \strokec6 1
\f1\b0\fs30 \cf2 \cb1 \strokec2 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b \cf2 Criar o espa\'e7o
\f1\b0  (SSH no contentor PWA)\
\pard\pardeftab720\partightenfactor0

\f4\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 pwa-app add minha-app\
\pard\pardeftab720\partightenfactor0

\f1\fs30 \cf2 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 Cria a pasta 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 /var/www/pwa/minha-app/
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0  com um placeholder.\
\pard\pardeftab720\partightenfactor0

\f0\b\fs24 \cf6 \cb7 \strokec6 2
\f1\b0\fs30 \cf2 \cb1 \strokec2 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b \cf2 Desenvolver a app localmente
\f1\b0 \
Use o framework que preferir (React, Vue, Svelte, vanilla). Configure o 
\f0\b base path
\f1\b0  para 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 /minha-app/
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 .\
\pard\pardeftab720\sa200\partightenfactor0

\f3\b\fs32 \cf2 \cb6 Exemplo \'97 Vite\cb1 \
\pard\pardeftab720\partightenfactor0

\f4\b0\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 // vite.config.ts\
export default defineConfig(\{\
  base: '/minha-app/',\
  // ...\
\})\
\pard\pardeftab720\partightenfactor0

\f0\b\fs24 \cf6 \cb7 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec6 3
\f1\b0\fs30 \cf2 \cb1 \strokec2 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b \cf2 Publicar
\f1\b0  \'97 copiar o build para o servidor\
\pard\pardeftab720\partightenfactor0

\f4\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 # De fora do contentor (via Proxmox host)\
scp -r ./dist/* root@192.168.1.231:/var/www/pwa/minha-app/\
\
# Ou via pct push (do Proxmox host)\
tar czf /tmp/app.tar.gz -C dist .\
pct push 204 /tmp/app.tar.gz /tmp/app.tar.gz\
pct exec 204 -- bash -c 'cd /var/www/pwa/minha-app && tar xzf /tmp/app.tar.gz && chown -R www-data:www-data .'\
\pard\pardeftab720\partightenfactor0

\f1\fs30 \cf2 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 A app fica dispon\'edvel em 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 https://pwa.windlog.org/minha-app/
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \
\pard\pardeftab720\sa320\partightenfactor0

\f2\b\fs40 \AppleTypeServices\AppleTypeServicesF65539 \cf2 PocketBase \'97 Backend\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b0\fs30 \AppleTypeServices \cf2 O PocketBase corre localmente na porta 8090. O Nginx faz proxy em 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 /api/
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 , portanto nas apps use caminhos relativos \'e0 raiz.\
\pard\pardeftab720\sa200\partightenfactor0

\f3\b\fs32 \cf2 Conectar ao PocketBase\
\pard\pardeftab720\partightenfactor0

\f4\b0\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 import PocketBase from 'pocketbase';\
\
// Usar '/' como base \'97 as chamadas v\'e3o para /api/...\
const pb = new PocketBase('/');\
pb.autoCancellation(false);\
\pard\pardeftab720\partightenfactor0

\f1\fs28\fsmilli14400 \cf8 \cb9 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec8 Nunca use 
\f4\fs25\fsmilli12672 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 new PocketBase('')
\f1\fs28\fsmilli14400 \cb9 \expnd0\expndtw0\kerning0
\outl0\strokewidth0  (string vazia). Isso faz as chamadas serem relativas ao path da app (
\f4\fs25\fsmilli12672 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 /minha-app/api/...
\f1\fs28\fsmilli14400 \cb9 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 ) em vez de ir para 
\f4\fs25\fsmilli12672 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 /api/...
\f1\fs28\fsmilli14400 \cb9 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 .\
\pard\pardeftab720\sa200\partightenfactor0

\f3\b\fs32 \cf2 \cb1 \strokec2 Collections\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b0\fs30 \cf2 Crie as collections no {\field{\*\fldinst{HYPERLINK "https://pwa.windlog.org/_/"}}{\fldrslt \cf7 \strokec7 Admin UI}} ou via API. Prefixe o nome com o nome da app para evitar conflitos:\
\pard\pardeftab720\partightenfactor0

\f4\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 minha-app_tarefas\
minha-app_notas\
minha-app_perfis\
\pard\pardeftab720\sa200\partightenfactor0

\f3\b\fs32 \cf2 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 Autentica\'e7\'e3o\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b0\fs30 \cf2 O PocketBase tem a collection 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 users
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0  integrada. Todas as apps partilham os mesmos utilizadores.\
\pard\pardeftab720\partightenfactor0

\f4\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 // Registar\
await pb.collection('users').create(\{\
  email: 'user@exemplo.com',\
  password: 'minhasenha00',\
  passwordConfirm: 'minhasenha00',\
  name: 'Nome',\
\});\
\
// Login\
await pb.collection('users').authWithPassword(\
  'user@exemplo.com',\
  'minhasenha00'\
);\
\
// Verificar sess\'e3o\
if (pb.authStore.isValid) \{\
  const user = pb.authStore.record;\
\}\
\
// Logout\
pb.authStore.clear();\
\pard\pardeftab720\partightenfactor0

\f1\fs28\fsmilli14400 \cf10 \cb11 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec10 Senha m\'ednima do PocketBase: 8 caracteres. O token de autentica\'e7\'e3o \'e9 guardado automaticamente no localStorage pelo SDK.\
\pard\pardeftab720\sa200\partightenfactor0

\f3\b\fs32 \cf2 \cb1 \strokec2 CRUD\
\pard\pardeftab720\partightenfactor0

\f4\b0\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 // Criar\
const record = await pb.collection('app_items').create(\{\
  titulo: 'Tarefa 1',\
  feito: false,\
  user: pb.authStore.record.id,\
\});\
\
// Listar (com filtro)\
const list = await pb.collection('app_items').getFullList(\{\
  filter: `user = "$\{pb.authStore.record.id\}"`,\
  sort: '-created',\
\});\
\
// Atualizar\
await pb.collection('app_items').update(record.id, \{\
  feito: true,\
\});\
\
// Apagar\
await pb.collection('app_items').delete(record.id);\
\pard\pardeftab720\sa200\partightenfactor0

\f3\b\fs32 \cf2 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 Realtime\
\pard\pardeftab720\partightenfactor0

\f4\b0\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 // Subscrever a altera\'e7\'f5es\
pb.collection('app_items').subscribe('*', (e) => \{\
  console.log(e.action, e.record);\
  // e.action: 'create' | 'update' | 'delete'\
\});\
\
// Cancelar subscri\'e7\'e3o\
pb.collection('app_items').unsubscribe();\
\pard\pardeftab720\sa200\partightenfactor0

\f3\b\fs32 \cf2 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 Ficheiros\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b0\fs30 \cf2 Para collections com campos do tipo 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 file
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 :\
\pard\pardeftab720\partightenfactor0

\f4\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 // Upload\
const formData = new FormData();\
formData.append('imagem', fileInput.files[0]);\
formData.append('titulo', 'Foto');\
const record = await pb.collection('app_fotos').create(formData);\
\
// URL do ficheiro\
const url = pb.files.getURL(record, record.imagem);\
\pard\pardeftab720\sa200\partightenfactor0

\f3\b\fs32 \cf2 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 Regras de acesso\
