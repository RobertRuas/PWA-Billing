\f1\b0\fs30 \cf2 O 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 start_url
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0  e 
\f4\fs26\fsmilli13200 \cb5 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 scope
\f1\fs30 \cb1 \expnd0\expndtw0\kerning0
\outl0\strokewidth0  devem apontar para a subpasta da app:\
\pard\pardeftab720\partightenfactor0

\f4\fs27\fsmilli13600 \cf2 \cb6 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \{\
  "name": "Minha App",\
  "short_name": "App",\
  "start_url": "/minha-app/",\
  "scope": "/minha-app/",\
  "display": "standalone",\
  "background_color": "#fafafa",\
  "theme_color": "#0071e3",\
  "icons": [\
    \{ "src": "/minha-app/icons/icon-192.png", "sizes": "192x192", "type": "image/png" \},\
    \{ "src": "/minha-app/icons/icon-512.png", "sizes": "512x512", "type": "image/png" \}\
  ]\
